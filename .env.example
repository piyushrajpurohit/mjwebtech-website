# ═══════════════════════════════════════════════════════════════════════════════
# Environment Configuration — MJ WebTech Pvt. Ltd.
# Copy this to .env and fill in your production values
# NEVER commit .env file — .env.example is for reference only
# ═══════════════════════════════════════════════════════════════════════════════

# ── Flask Environment ──
# Options: development, production, testing
FLASK_ENV=production

# ── Secret Key ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED for production
SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL on Render (recommended for production)
# Format: postgresql://username:password@host:5432/database
# Render provides DATABASE_URL automatically if you link a PostgreSQL database
DATABASE_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (Brevo)
# ═══════════════════════════════════════════════════════════════════════════════

# Required on Render: transactional API key (HTTPS). SMTP ports 587/465 hang there.
# Brevo → Settings → SMTP & API → API Keys  (this is not the SMTP key)
BREVO_API_KEY=

# Must be a sender verified in Brevo (Senders, domains & IPs)
MAIL_DEFAULT_SENDER=noreply@mjwebtech.in

# Optional local SMTP fallback (often blocked on Render)
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT=8
MAIL_USERNAME=
MAIL_PASSWORD=

# Admin contact email (receives new contact form submissions)
CONTACT_EMAIL=info@mjwebtech.in

# ═══════════════════════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Frontend domain(s) that can access the Render API (set this on Render)
# Format: https://your-site.netlify.app,https://www.your-domain.com
# Do NOT include localhost in production
# Leave empty here; set the real Netlify / custom-domain origin in the Render dashboard
CORS_ORIGINS=

# Public frontend API origin used when exporting static HTML for Netlify
# Local Flask should leave this empty (same-origin)
API_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUDFLARE TURNSTILE (Optional CAPTCHA)
# ═══════════════════════════════════════════════════════════════════════════════

# For contact form CAPTCHA protection
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT-SPECIFIC SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# Render: Set PORT (usually set automatically by Render)
PORT=5000

# Netlify build: API_BASE_URL is set in netlify.toml
# Render dashboard: set CORS_ORIGINS to your Netlify site URL (and custom domain later)
# Example: https://your-site.netlify.app
