# ═══════════════════════════════════════════════════════════════════════════════
# Environment Configuration — MJ WebTech Pvt. Ltd.
# Copy this to .env and fill in your production values
# NEVER commit .env file — .env.example is for reference only
# ═══════════════════════════════════════════════════════════════════════════════

# ── Flask Environment ──
# Options: development, production, testing
FLASK_ENV=production

# ── Secret Key ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED for production
SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL on Render (recommended for production)
# Format: postgresql://username:password@host:5432/database
# Render provides DATABASE_URL automatically if you link a PostgreSQL database
DATABASE_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (Flask-Mail)
# ═══════════════════════════════════════════════════════════════════════════════

# SMTP Server (Gmail recommended)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Gmail: Use your account email and App Password
# Gmail App Password: https://myaccount.google.com/apppasswords (requires 2FA enabled)
MAIL_USERNAME=
MAIL_PASSWORD=

# Default sender email address for system notifications
MAIL_DEFAULT_SENDER=noreply@mjwebtech.com

# Admin contact email (receives new contact form submissions)
CONTACT_EMAIL=info@mjwebtech.com

# ═══════════════════════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Frontend domain(s) that can access this API
# Format: https://domain1.com,https://domain2.com
# Do NOT include localhost in production
CORS_ORIGINS=https://MY_DOMAIN,https://www.MY_DOMAIN

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUDFLARE TURNSTILE (Optional CAPTCHA)
# ═══════════════════════════════════════════════════════════════════════════════

# For contact form CAPTCHA protection
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT-SPECIFIC SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# Render: Set PORT (usually set automatically by Render)
PORT=5000

# Netlify: These are set in Netlify UI, not in .env
# - Add FLASK_ENV=production
# - Add CORS_ORIGINS=your-frontend-domain
